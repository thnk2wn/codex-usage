{
  "mcpServers": {
    "codex_usage": {
      "command": "/usr/bin/python3",
      "args": [
        "scripts/server.py"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "CODEX_HOME",
        "CODEX_SESSION_ID",
        "CODEX_THREAD_ID",
        "HOME",
        "TZ"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 120
    }
  }
}
